<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="dronepad">
    <static>true</static>
    <pose>0 0 0.005 0 0 0</pose>
    <link name="base">
      <visual name="base_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>6 6</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://dronepad/dronepad.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>6 6 0.02</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
