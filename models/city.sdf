<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="city">
    <!-- ── Physics Engine Configuration (250 Hz ODE) ── -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.65 0.67 0.72 1.0</ambient>
      <background>0.70 0.80 0.92 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- ── Sun Light ── -->
    <light name="sun" type="directional">
      <pose>40 50 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.35</intensity>
      <direction>-0.35 -0.4 -0.84</direction>
      <diffuse>0.98 0.96 0.92 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
    </light>

    <!-- ══════════════════════════════════════════════════════════════════════════
         1. GROUND, BOULEVARDS & CENTRAL LAUNCH PLAZA
         ══════════════════════════════════════════════════════════════════════════ -->

    <!-- Master Asphalt Ground Plane (800m x 800m) -->
    <model name="city_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>800 800</size>
            </plane>
          </geometry>
        </collision>
        <visual name="asphalt">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>800 800</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.20 1.0</ambient>
            <diffuse>0.22 0.22 0.24 1.0</diffuse>
            <specular>0.08 0.08 0.08 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central Plaza (44m x 44m granite drone staging area at origin) -->
